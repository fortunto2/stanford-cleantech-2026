{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the horizon to see where fires and air monitors are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al horizonte para ver dónde están los incendios y los monitores de aire."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location gives the compass true north, so fire and monitor labels sit on the right bearing. A report you send carries where you were, rounded to about 100 m."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación le da a la brújula el norte verdadero, para que las etiquetas queden en la dirección correcta. Un reporte que envías lleva dónde estabas, redondeado a unos 100 m."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device motion tells the app which way the camera points, so labels stay on the horizon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento del teléfono le dice a la app hacia dónde apunta la cámara, para que las etiquetas queden en el horizonte."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crew Air"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crew Air"
          }
        }
      }
    }
  }
}